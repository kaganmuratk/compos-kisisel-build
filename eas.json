{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "personal": {
      "distribution": "internal",
      "channel": "personal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PERSONAL": "true"
      }
    },
    "huawei": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_HIDE_HEALTH_CONNECT": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
